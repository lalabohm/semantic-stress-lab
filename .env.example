# Copy this file to .env and fill in your keys.
# Never commit the real .env file (it is already covered by .gitignore).

# Google Generative AI — used to call Gemini 2.5 Flash.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — used to call Llama 3.3 (70B) via Groq's hosted inference.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Ollama — used to call Qwen3 locally. No API key required; only override
# the host if Ollama is not running on its default local address.
OLLAMA_HOST=http://localhost:11434
